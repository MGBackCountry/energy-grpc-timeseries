# =========================
# 1) BUILD STAGE
# =========================
FROM python:3.12-slim AS builder

WORKDIR /app

# System tools
RUN apt update && apt install -y --no-install-recommends \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# Copy dependency metadata first (best cache reuse)
COPY pyproject.toml /app/

# Install dependencies. This repository does not commit a uv.lock file.
RUN uv sync

COPY Makefile /app/
COPY protos/ /app/protos/
COPY --exclude=src/generated src/ /app/src/

# Create generated package directory
RUN mkdir -p /app/src/energy_server/generated \
    && touch /app/src/energy_server/generated/__init__.py

# Generate gRPC code
# This layer is only invalidated if:
# - Makefile changes
# - protos/ changes
RUN make gen-protos

# Fix relative imports in generated files
RUN sed -i 's/^import energy_pb2 as energy__pb2$/from . import energy_pb2 as energy__pb2/' /app/src/energy_server/generated/energy_pb2_grpc.py

# Install package into system Python
RUN uv pip install --system .

# =========================
# 2) RUNTIME STAGE
# =========================
FROM python:3.12-slim AS runtime

WORKDIR /app

# Copy installed Python environment from builder
COPY --from=builder /usr/local /usr/local

# Set Python to run in unbuffered mode for better logging
ENV PYTHONUNBUFFERED=1

# Run the installed CLI
CMD ["energy-server"]